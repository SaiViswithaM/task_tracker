          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/register.php",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "register.php"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.csrf_token) pm.environment.set(\"csrf_token\", data.csrf_token);",
              "pm.test(\"Registration response received\", function () { pm.expect(data).to.have.property(\"success\"); });"
            ]
          }
        }
      ]
    },
