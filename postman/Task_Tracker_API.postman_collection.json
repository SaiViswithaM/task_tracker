          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.task && data.task.id) pm.environment.set(\"task_id\", data.task.id);",
              "pm.test(\"Create returns success or validation/auth error\", function () { pm.expect(pm.response.code).to.be.oneOf([201, 401, 403, 422]); });"
            ]
          }
        }
      ]
